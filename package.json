{
  "name": "life-butler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:design && tsc --noEmit && vite build",
    "preview": "vite preview --port 4190 --strictPort",
    "build:blank": "npm run lint:design && tsc --noEmit && vite build --mode blank --outDir dist-blank",
    "preview:blank": "vite preview --port 4191 --strictPort --outDir dist-blank",
    "lint:design": "node tools/lint-design.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
